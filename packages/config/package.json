  },
  "scripts": {
    "build": "tsc && node build-cjs.mjs",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "windsurf",
    "mcp-config"
