{
  "name": "@mcpub/config",
  "version": "0.1.0",
  "description": "Detect MCP clients and manage their config files — Claude Desktop, Cursor, Windsurf, Continue, VS Code",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
