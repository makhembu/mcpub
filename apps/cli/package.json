{
  "name": "@mcpub/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "mcpub": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --minify --out-dir dist",
    "dev": "tsup src/index.ts --format esm --watch --out-dir dist",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@mcpub/shared": "workspace:*",
    "@mcpub/security": "workspace:*",
    "@clack/prompts": "^0.9.0",
    "commander": "^12.0.0",
    "conf": "^13.1.0",
    "ora": "^8.1.0",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
